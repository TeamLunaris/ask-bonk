{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunaris-bonk",
  "account_id": "baab7ce06bd920762c769417436615b6",
  "workers_dev": false,
  "routes": [{ "pattern": "bonk.lunaris.sh", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.hbs", "**/*.hbs?raw", "**/*.sql", "**/*.sql?raw"],
      "fallthrough": true,
    },
  ],
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "vars": {
    // Account used by the public Analytics Engine-backed /stats endpoint
    "CLOUDFLARE_ACCOUNT_ID": "baab7ce06bd920762c769417436615b6",
    // Default model for OpenCode sessions
    "DEFAULT_MODEL": "anthropic/claude-opus-5-5",
    "BONK_VERSION": "dev",
    "BONK_COMMIT": "unknown",
    // Allowed orgs/users for GitHub App installation
    "ALLOWED_ORGS": ["TeamLunaris"],
  },
  "secrets": {
    "required": ["GITHUB_APP_ID", "GITHUB_APP_PRIVATE_KEY", "GITHUB_WEBHOOK_SECRET"],
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RepoAgent",
        "name": "REPO_AGENT",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v4",
      "new_sqlite_classes": ["RepoAgent", "Sandbox"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["FlueRegistry", "FlueControlPlaneAgent"],
    },
    {
      "tag": "v6",
      "deleted_classes": ["Sandbox"],
    },
    {
      "tag": "v7",
      "new_sqlite_classes": [
        "FlueGithubSetupWorkflow",
        "FlueGithubTrackWorkflow",
        "FlueGithubFinalizeWorkflow",
      ],
    },
  ],
  "kv_namespaces": [
    {
      "binding": "APP_INSTALLATIONS",
      "id": "89bb25021a7149ddb0097497f7e7f300",
    },
  ],
  // Rate limiter for issues events from non-write users: 5 requests per minute
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "BONK_EVENTS",
      "dataset": "bonk_events",
    },
  ],
}
